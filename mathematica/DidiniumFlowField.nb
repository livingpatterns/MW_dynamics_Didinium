Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "create", " ", "a", " ", "single", " ", "tube",
     " ", "arrow"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tubeArrow", "[", 
     RowBox[{"base_", ",", "dir_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"shaftEnd", ",", "headBase", ",", "headTip"}], "}"}], ",", 
      RowBox[{
       RowBox[{"shaftEnd", "=", 
        RowBox[{"base", "+", 
         RowBox[{"dir", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"headLength", "/", "arrowLength"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"headBase", "=", "shaftEnd"}], ";", "\[IndentingNewLine]", 
       RowBox[{"headTip", "=", 
        RowBox[{"base", "+", "dir"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"base", ",", "shaftEnd"}], "}"}], ",", "shaftRadius"}], 
          "]"}], ",", 
         RowBox[{"Cone", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"headBase", ",", "headTip"}], "}"}], ",", "headRadius"}], 
          "]"}]}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "arrows"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrows", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"theta", ",", "base", ",", "dir"}], "}"}], ",", 
         RowBox[{
          RowBox[{"theta", "=", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"k", "/", "n"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Base", " ", "point", " ", "on", " ", "ring"}], "*)"}], 
          RowBox[{"base", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"radius", " ", 
              RowBox[{"Cos", "[", "theta", "]"}]}], ",", 
             RowBox[{"radius", " ", 
              RowBox[{"Sin", "[", "theta", "]"}]}], ",", 
             RowBox[{"\[Rho]var", " ", 
              RowBox[{"Cos", "[", "\[Theta]var", "]"}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Tangential", " ", "direction"}], " ", "*)"}], 
          RowBox[{"dir", "=", 
           RowBox[{"arrowLength", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Sin", "[", "theta", "]"}], ",", 
              RowBox[{"-", 
               RowBox[{"Cos", "[", "theta", "]"}]}], ",", "0"}], "}"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"tubeArrow", "[", 
           RowBox[{"base", ",", "dir"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrowsB", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"theta", ",", "base", ",", "dir"}], "}"}], ",", 
         RowBox[{
          RowBox[{"theta", "=", 
           RowBox[{
            RowBox[{"2", " ", "Pi", " ", 
             RowBox[{"k", "/", "4"}]}], "+", 
            RowBox[{"\[Pi]", "/", "4"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Base", " ", "point", " ", "on", " ", "ring"}], "*)"}], 
          RowBox[{"base", "=", 
           RowBox[{"0.5", 
            RowBox[{"{", " ", 
             RowBox[{
              RowBox[{"Cos", "[", "theta", "]"}], ",", 
              RowBox[{"Sin", "[", "theta", "]"}], ",", "0"}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Tangential", " ", "direction"}], " ", "*)"}], 
          RowBox[{"dir", "=", 
           RowBox[{"0.15", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"Sin", "[", "theta", "]"}]}], ",", 
              RowBox[{"Cos", "[", "theta", "]"}], ",", "0"}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tubeArrow", "[", 
           RowBox[{"base", ",", "dir"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"4", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ring", "=", 
     RowBox[{"ParametricPlot3D", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"0.5", "+", 
            RowBox[{"0.01", " ", 
             RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
          RowBox[{"Cos", "[", "u", "]"}]}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"0.5", "+", 
            RowBox[{"0.01", 
             RowBox[{"Cos", "[", "v", "]"}]}]}], ")"}], " ", 
          RowBox[{"Sin", "[", "u", "]"}]}], ",", 
         RowBox[{"0.01", " ", 
          RowBox[{"Sin", "[", "v", "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"u", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"v", ",", "0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"PlotStyle", "->", "Blue"}], ",", 
       RowBox[{"Mesh", "->", "None"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", "Render", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plotToSave", "=", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.25", "]"}], ",", "Green", ",", 
         RowBox[{"Sphere", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "1"}], "]"}]}], 
        "}"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{"Red", ",", "arrows"}], "}"}], "]"}], ",", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", "arrowsB"}], "}"}], "]"}], ",", "ring", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Background", "\[Rule]", "Black"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", 
       RowBox[{"800", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}]}], ",", 
      RowBox[{"Boxed", "->", "False"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
      RowBox[{"ViewVector", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "2", ",", "1.5"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "0.1"}], "}"}]}], "}"}]}], ",", 
      RowBox[{"ViewVertical", "->", 
       RowBox[{"{", 
        RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], ",", 
      RowBox[{"ViewAngle", "->", 
       RowBox[{"50", 
        RowBox[{"\[Pi]", "/", "180"}]}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SetDirectory", "[", 
     RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<ArrowsB.jpg\>\"", ",", "plotToSave"}], "]"}]}]}]], "Input",
