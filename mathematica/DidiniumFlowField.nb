       SuperscriptBox["GoldenRatio", 
        RowBox[{"-", "1"}]]}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"10", "/", 
       SuperscriptBox["z", "3"]}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "10", ",", "100"}], "}"}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.01", "]"}], ",", " ", 
         RowBox[{"Dashing", "[", "0.04", "]"}], ",", " ", "Black"}], 
        "}"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"0.3", "/", 
       SuperscriptBox["z", "4"]}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "5", ",", "100"}], "}"}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.01", "]"}], ",", " ", 
