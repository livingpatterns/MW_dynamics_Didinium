            RowBox[{"0", ",", "0", ",", "0.65"}], "}"}]}], "]"}]}], "}"}], 
       "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Background", "\[Rule]", "Black"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", 
       RowBox[{"800", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}]}], ",", 
      RowBox[{"Boxed", "->", "False"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
