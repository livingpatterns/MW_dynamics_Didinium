Cell[BoxData[{
 RowBox[{
  RowBox[{"uPlot", "=", 
   RowBox[{"uSwimmerN", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "z"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"\[Rho]var", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]var", "]"}], ",", 
        RowBox[{"Sin", "[", "\[Theta]var", "]"}]}], "}"}]}], ",", "1", ",", 
     "1", ",", "0", ",", "12"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ScalePlotA", "=", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
           "uPlot", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
           "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "->", "0"}], ",", 
            RowBox[{"z", "->", "r"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
           "uPlot", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
           "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "->", "0"}], ",", 
            RowBox[{"z", "->", 
             RowBox[{"-", "r"}]}]}], "}"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
           "uPlot", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"z", "->", "0"}], ",", 
            RowBox[{"x", "->", "r"}]}], "}"}]}]}], "}"}], "]"}], 
      "\[IndentingNewLine]", ",", 
