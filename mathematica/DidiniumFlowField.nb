  3.985971881356709*^9}},ExpressionUUID->"51b08c8e-cc0f-408d-8266-\
41aa23d54072"],

Cell[BoxData[
 RowBox[{
  RowBox[{"uSwimmerNM", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"xs_", ",", "ys_", ",", "zs_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"zf_", ",", "\[Rho]f_"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"zf2_", ",", "\[Rho]f2_"}], "}"}], ",", "A_", ",", "V_", ",", 
    "\[CapitalOmega]_", ",", "NN_Integer", ",", "MM_Integer"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"RXX", "=", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "-", 
        RowBox[{"{", 
         RowBox[{"xs", ",", "ys", ",", "zs"}], "}"}]}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Fz", "=", 
       RowBox[{
        RowBox[{"-", 
         FractionBox["1", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox[
