Cell[BoxData[{
 RowBox[{
  RowBox[{"uPlot", "=", 
   RowBox[{"uSwimmerN", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "z"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"\[Rho]var", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]var", "]"}], ",", 
        RowBox[{"Sin", "[", "\[Theta]var", "]"}]}], "}"}]}], ",", "1", ",", 
     "0", ",", "1", ",", "12"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"ScalePlotB", "=", 
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LogLogPlot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
           "uPlot", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
           "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "->", 
             RowBox[{"r", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"\[Pi]", "/", "4"}], "]"}]}]}], ",", 
            RowBox[{"z", "->", 
             RowBox[{"r", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"\[Pi]", "/", "4"}], "]"}]}]}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
           "uPlot", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
           "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"x", "->", 
             RowBox[{"r", " ", 
              RowBox[{"Sin", "[", 
               RowBox[{"3", 
                RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}]}], ",", 
            RowBox[{"z", "->", 
             RowBox[{"r", " ", 
              RowBox[{"Cos", "[", 
               RowBox[{"3", 
                RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}]}]}], "}"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
           "uPlot", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
           "]"}], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"z", "->", "0"}], ",", 
            RowBox[{"x", "->", "r"}]}], "}"}]}]}], "}"}], "]"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "1", ",", "100"}], "}"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         SuperscriptBox["10", 
          RowBox[{"-", "7"}]], ",", "7"}], "}"}]}], ",", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"Thickness", "[", "0.01", "]"}]}], ",", 
