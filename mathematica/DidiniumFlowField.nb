Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "create", " ", "a", " ", "single", " ", "tube",
     " ", "arrow"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tubeArrow", "[", 
     RowBox[{"base_", ",", "dir_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"shaftEnd", ",", "headBase", ",", "headTip"}], "}"}], ",", 
      RowBox[{
       RowBox[{"shaftEnd", "=", 
        RowBox[{"base", "+", 
         RowBox[{"dir", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"headLength", "/", "arrowLength"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"headBase", "=", "shaftEnd"}], ";", "\[IndentingNewLine]", 
       RowBox[{"headTip", "=", 
        RowBox[{"base", "+", "dir"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"base", ",", "shaftEnd"}], "}"}], ",", "shaftRadius"}], 
          "]"}], ",", 
         RowBox[{"Cone", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"headBase", ",", "headTip"}], "}"}], ",", "headRadius"}], 
          "]"}]}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "arrows"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"arrows", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"theta", ",", "base", ",", "dir"}], "}"}], ",", 
         RowBox[{
          RowBox[{"theta", "=", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"k", "/", "n"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Base", " ", "point", " ", "on", " ", "ring"}], "*)"}], 
          RowBox[{"base", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"radius", " ", 
              RowBox[{"Cos", "[", "theta", "]"}]}], ",", 
             RowBox[{"radius", " ", 
              RowBox[{"Sin", "[", "theta", "]"}]}], ",", 
             RowBox[{"\[Rho]var", " ", 
              RowBox[{"Cos", "[", "\[Theta]var", "]"}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"z", " ", "direction"}], "*)"}], 
          RowBox[{"dir", "=", 
           RowBox[{"arrowLength", " ", 
            RowBox[{"{", 
             RowBox[{"0", ",", "0", ",", 
              RowBox[{"-", "1"}]}], "}"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Tangential", " ", "direction"}], " ", "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"dir", "=", 
             RowBox[{"arrowLength", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"Sin", "[", "theta", "]"}]}], ",", 
                RowBox[{"Cos", "[", "theta", "]"}], ",", "0"}], "}"}]}]}], 
            ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"tubeArrow", "[", 
           RowBox[{"base", ",", "dir"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"axes", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Graphics3D", "[", 
        RowBox[{"{", 
         RowBox[{"White", ",", 
          RowBox[{"tubeArrow", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{
               RowBox[{"-", "1"}], "/", "2"}], ",", 
              RowBox[{"-", "1"}]}], "}"}], ",", 
            RowBox[{"0.3", "k"}]}], "]"}]}], "}"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "Render", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plotToSave", "=", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{
