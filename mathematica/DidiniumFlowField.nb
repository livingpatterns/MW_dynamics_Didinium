Cell[CellGroupData[{

Cell["(*Plot flow in lab frame*)", "Section",
 CellChangeTimes->{{3.985959011778775*^9, 
  3.985959036673026*^9}},ExpressionUUID->"91eee3fe-2242-46bc-8c53-\
5bae692b7ef1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mm", "=", "3"}], ";", 
  RowBox[{"mmoff", "=", 
   RowBox[{"-", "0.5"}]}], ";", 
  RowBox[{"rl", "=", "0"}], ";", 
  RowBox[{"rr", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uPlot", "=", 
   RowBox[{"uSwimmerN", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "z"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"\[Rho]var", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]var", "]"}], ",", 
        RowBox[{"Sin", "[", "\[Theta]var", "]"}]}], "}"}]}], ",", "1", ",", 
     "1", ",", "0", ",", "12"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uPlot", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"uPlot", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
     ",", 
     RowBox[{
     "uPlot", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"FlowALabPlot", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"Evaluate", "[", 
       RowBox[{"N", "[", 
        RowBox[{"Norm", "[", "uPlot", "]"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"-", "mm"}], "-", "mmoff"}], ",", 
        RowBox[{"mm", "-", "mmoff"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "mm"}], ",", "mm"}], "}"}], ",", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "10000"}], "rl"}], ",", 
         RowBox[{"10000", "rr"}]}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"ColorFunctionScaling", "\[Rule]", "False"}], ",", 
      RowBox[{"ColorFunction", "\[Rule]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "\"\<DeepSeaColors\>\"", "]"}], "[", 
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"#", ">", "rr"}], ",", "rr", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"#", "<", 
                  RowBox[{"-", "rl"}]}], ",", 
                 RowBox[{"-", "rl"}], ",", "#"}], "]"}]}], "]"}], "+", "rl"}], 
            RowBox[{"(", 
             RowBox[{"rl", "+", "rr"}], ")"}]], ")"}], "]"}], "&"}], ")"}]}], 
      ",", 
      RowBox[{"PlotPoints", "\[Rule]", "200"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"VectorPlot", "[", 
     RowBox[{"uPlot", ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"-", "mm"}], "-", "mmoff"}], ",", 
        RowBox[{"mm", "-", "mmoff"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "mm"}], ",", "mm"}], "}"}], ",", 
      RowBox[{"VectorColorFunction", "\[Rule]", "None"}], ",", 
      RowBox[{"VectorStyle", "\[Rule]", "Black"}], ",", 
      RowBox[{"VectorPoints", "\[Rule]", "8"}], ",", 
      RowBox[{"VectorScaling", "->", "None"}], ",", 
      RowBox[{"VectorSizes", "\[Rule]", "1"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"StreamPlot", "[", 
       RowBox[{"uPlot", ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", 
          RowBox[{
           RowBox[{"-", "mm"}], "-", "mmoff"}], ",", 
          RowBox[{"mm", "-", "mmoff"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"-", "mm"}], ",", "mm"}], "}"}], ",", 
        RowBox[{"StreamColorFunction", "\[Rule]", "None"}], ",", 
        RowBox[{"StreamStyle", "\[Rule]", "Black"}], ",", 
        RowBox[{"StreamPoints", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"Automatic", ",", "0.8"}], "}"}]}], ",", 
        RowBox[{"StreamScale", "\[Rule]", "Large"}]}], "]"}], ","}], "*)"}], 
    "\[IndentingNewLine]", 
    RowBox[{"StreamPlot", "[", 
     RowBox[{"uPlot", ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", 
        RowBox[{
         RowBox[{"-", "mm"}], "-", "mmoff"}], ",", 
        RowBox[{"mm", "-", "mmoff"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "mm"}], ",", "mm"}], "}"}], ",", 
      RowBox[{"StreamColorFunction", "\[Rule]", "None"}], ",", 
      RowBox[{"StreamPoints", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", "0.2"}], "}"}]}], ",", 
      RowBox[{"StreamScale", "\[Rule]", "None"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Thick", ",", "Black", ",", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", "1"}], "]"}]}], "}"}], "]"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Thick", ",", "Red", ",", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"\[Rho]var", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]var", "]"}], ",", 
            RowBox[{"Sin", "[", "\[Theta]var", "]"}]}], "}"}]}], ",", 
         "0.05"}], "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Graphics", "[", 
     RowBox[{"{", 
      RowBox[{"Thick", ",", "Red", ",", 
       RowBox[{"Disk", "[", 
        RowBox[{
         RowBox[{"\[Rho]var", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "\[Theta]var", "]"}], ",", 
            RowBox[{"Sin", "[", "\[Theta]var", "]"}]}], "}"}]}], ",", 
         "0.05"}], "]"}]}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "False"}], ",", 
    RowBox[{"LabelStyle", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"FontSize", "\[Rule]", "20"}], ",", 
       RowBox[{"FontFamily", "\[Rule]", "\"\<Arial\>\""}]}], "}"}]}], ",", 
    RowBox[{"PlotRangePadding", "\[Rule]", "None"}], ",", 
    RowBox[{"ImageSize", "->", "800"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"LegendToSave", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"DensityPlot", "[", 
     RowBox[{
      RowBox[{"x", "/", "5"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"AspectRatio", "\[Rule]", "Automatic"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ColorFunctionScaling", "\[Rule]", "False"}], ",", 
      RowBox[{"ColorFunction", "\[Rule]", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "\"\<DeepSeaColors\>\"", "]"}], "[", "#", 
          "]"}], "&"}], ")"}]}], ",", 
      RowBox[{"PlotPoints", "\[Rule]", "20"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "\[Rule]", "False"}], ",", 
