Cell[BoxData[{
 RowBox[{
  RowBox[{"uPlot", "=", 
   RowBox[{"uSwimmerNM", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "z"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"\[Rho]var", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Theta]var", "]"}], ",", 
        RowBox[{"Sin", "[", "\[Theta]var", "]"}]}], "}"}]}], ",", 
