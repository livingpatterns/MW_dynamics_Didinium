Cell[BoxData[{
 RowBox[{
  RowBox[{"mm", "=", "3"}], ";", 
  RowBox[{"mmoff", "=", 
   RowBox[{"-", "0.5"}]}], ";", 
  RowBox[{"rl", "=", "0"}], ";", 
  RowBox[{"rr", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"{", 
  RowBox[{"\[Rho]var", ",", "\[Rho]2var", ",", 
   RowBox[{"\[Theta]var", " ", 
    RowBox[{"180.", "/", "\[Pi]"}]}], ",", 
   RowBox[{"\[Theta]2var", " ", 
    RowBox[{"180.", "/", "\[Pi]"}]}]}], "}"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uPlot", "=", 
   RowBox[{"uSwimmerNM", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "z"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"\[Rho]var", 
      RowBox[{"{", 
