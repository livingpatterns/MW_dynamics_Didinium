Cell[CellGroupData[{

Cell["(*Didinium*)", "Section",
 CellChangeTimes->{{3.985983114723226*^9, 
  3.985983126303185*^9}},ExpressionUUID->"a98bb844-5f8f-4392-b562-\
78565b0ced47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "create", " ", "a", " ", "single", " ", "tube",
     " ", "arrow"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"tubeArrow", "[", 
     RowBox[{"base_", ",", "dir_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"shaftEnd", ",", "headBase", ",", "headTip"}], "}"}], ",", 
      RowBox[{
       RowBox[{"shaftEnd", "=", 
        RowBox[{"base", "+", 
         RowBox[{"dir", " ", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"headLength", "/", "arrowLength"}]}], ")"}]}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"headBase", "=", "shaftEnd"}], ";", "\[IndentingNewLine]", 
       RowBox[{"headTip", "=", 
        RowBox[{"base", "+", "dir"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Tube", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"base", ",", "shaftEnd"}], "}"}], ",", "shaftRadius"}], 
          "]"}], ",", 
         RowBox[{"Cone", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"headBase", ",", "headTip"}], "}"}], ",", "headRadius"}], 
          "]"}]}], "}"}]}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Generate", " ", "arrows"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrows", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"theta", ",", "base", ",", "dir"}], "}"}], ",", 
         RowBox[{
          RowBox[{"theta", "=", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"k", "/", "n1"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Base", " ", "point", " ", "on", " ", "ring"}], "*)"}], 
          RowBox[{"base", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"radius", " ", 
              RowBox[{"Cos", "[", "theta", "]"}]}], ",", 
             RowBox[{"radius", " ", 
              RowBox[{"Sin", "[", "theta", "]"}]}], ",", 
             RowBox[{"\[Rho]var", " ", 
              RowBox[{"Cos", "[", "\[Theta]var", "]"}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "direction", " ", "*)"}], 
          RowBox[{"dir", "=", 
           RowBox[{"arrowLength", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Sin", "[", "theta", "]"}], 
               RowBox[{"Sin", "[", "\[Phi]var", "]"}]}], ",", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"Cos", "[", "theta", "]"}]}], 
               RowBox[{"Sin", "[", "\[Phi]var", "]"}]}], ",", 
              RowBox[{"-", 
               RowBox[{"Cos", "[", "\[Phi]var", "]"}]}]}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tubeArrow", "[", 
           RowBox[{"base", ",", "dir"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"n1", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"arrows2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"theta", ",", "base", ",", "dir"}], "}"}], ",", 
         RowBox[{
          RowBox[{"theta", "=", 
           RowBox[{"2", " ", "Pi", " ", 
            RowBox[{"k", "/", "n2"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Base", " ", "point", " ", "on", " ", "ring"}], "*)"}], 
          RowBox[{"base", "=", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"radius2", " ", 
              RowBox[{"Cos", "[", "theta", "]"}]}], ",", 
             RowBox[{"radius2", " ", 
              RowBox[{"Sin", "[", "theta", "]"}]}], ",", 
             RowBox[{"\[Rho]var", " ", 
              RowBox[{"Cos", "[", "\[Theta]2var", "]"}]}]}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "direction", " ", "*)"}], 
          RowBox[{"dir", "=", 
           RowBox[{"arrowLength", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"Sin", "[", "theta", "]"}], 
               RowBox[{"Sin", "[", "\[Phi]var", "]"}]}], ",", 
              RowBox[{
               RowBox[{"-", 
                RowBox[{"Cos", "[", "theta", "]"}]}], 
               RowBox[{"Sin", "[", "\[Phi]var", "]"}]}], ",", 
              RowBox[{"-", 
               RowBox[{"Cos", "[", "\[Phi]var", "]"}]}]}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"tubeArrow", "[", 
           RowBox[{
            RowBox[{"base", "-", "dir"}], ",", "dir"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "0", ",", 
         RowBox[{"n2", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", "Render", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"plotToSave", "=", 
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.25", "]"}], ",", "Green", ",", 
         RowBox[{"Sphere", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", "1"}], "]"}]}], 
        "}"}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{"Red", ",", "arrows"}], "}"}], "]"}], ",", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{"Red", ",", "arrows2"}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", 
         RowBox[{"tubeArrow", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "0", ",", "0.65"}], "}"}]}], "]"}]}], "}"}], 
       "]"}], ",", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{"{", 
        RowBox[{"Blue", ",", "arrowsB"}], "}"}], "]"}], ",", "ring", ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Background", "\[Rule]", "Black"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", 
       RowBox[{"800", 
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}]}]}], ",", 
      RowBox[{"Boxed", "->", "False"}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"Lighting", "->", "\"\<Neutral\>\""}], ",", 
      RowBox[{"ViewVector", "->", 
